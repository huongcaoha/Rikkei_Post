# ==========================================
# Root .gitignore for Logistics Research Project
# ==========================================

# Gradle
.gradle/
**/build/
!gradle/wrapper/gradle-wrapper.jar
backend/.gradle/
backend/build/
backend/out/

# Maven (if any)
target/
**/target/
backend/target/

# Node & Frontend
node_modules/
**/node_modules/
frontend/node_modules/
frontend/dist/
frontend/.env.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editors
.idea/
*.iml
*.iws
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# OS & Logs
.DS_Store
Thumbs.db
*.log
*.tmp
